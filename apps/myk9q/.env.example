# Supabase Configuration (shared myk9-platform project)
# Copy this file to .env.local and fill in your actual values

# Supabase Project URL (found in your Supabase dashboard)
VITE_SUPABASE_URL=your_supabase_project_url

# Supabase Anon/Public Key (found in your Supabase dashboard under Settings > API)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Environment identifier (development, staging, production)
VITE_ENVIRONMENT=development

# =================================================================
# RULES ASSISTANT CONFIGURATION
# =================================================================
# Anthropic API Key for Claude Haiku (Rules Assistant AI search)
# Get your key from: https://console.anthropic.com/settings/keys
# Required for: supabase/functions/search-rules Edge Function
# Cost: ~$0.00014 per query (~$2-3/year for typical usage)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here