{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    /* Temporarily disabled for Base UI migration and pre-existing type issues */
    /* TODO: Re-enable strict mode incrementally after migration stabilizes */
    "strict": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,

    /* Core Safety Features */
    "noImplicitOverride": false,
    "noImplicitReturns": false,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,

    /* Temporarily Disabled for Gradual Migration */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false,

    /* Temporarily disabled for Base UI migration - callback type inference issues */
    /* TODO: Re-enable and add explicit types to callbacks after migration stabilizes */
    "noImplicitAny": false
  },
  "include": ["src"],
  "exclude": [
    "src/test/**/*",
    "src/**/__tests__/**/*", 
    "src/**/*.test.ts",
    "src/services/sync/backgroundSyncService.ts",
    "src/services/sync/conflictResolutionStrategies.ts",
    "src/services/sync/dataVersioningService.ts",
    "src/services/sync/tombstoneService.ts",
    "src/services/sync/queueManager.ts",
    "src/services/sync/realtimeManager.ts",
    "src/services/sync/networkMonitor.ts",
    "src/services/sync/FieldLevelSyncService.ts",
    "src/services/sync/SyncConflictResolver.ts",
    "src/services/sync/SyncQueue.ts",
    "src/services/sync/types.ts",
    "src/services/conflict/**/*",
    "src/services/conflict/ConflictResolver.ts",
    "src/components/sync/**/*",
    "src/components/conflict/**/*", 
    "src/hooks/useConflictResolution.ts",
    "src/hooks/useBackgroundSync.ts",
    "src/hooks/useFieldLevelSync.ts",
    "src/hooks/useRegistrationConflicts.ts",
    "src/services/realtime/**/*",
    "src/examples/field-level-sync-example.ts",
    "src/services/scoring/OfflineScoringService.ts",
    "src/components/scoring/JudgeSyncDashboard.tsx",
    "src/components/scoring/OfflineScoringModeIndicator.tsx",
    "src/store/offlineScoringStore.ts",
    "src/services/sync/index.ts",
    "src/components/admin/permissions/BulkPermissionOperations.tsx",
    "src/components/admin/UserImpersonationDialog.tsx",
    "src/components/alerts/AlertToast.tsx",
    "src/components/analytics/MonitoringDashboard.tsx",
    "src/components/common/LazyComponents.tsx",
    "src/components/common/SearchPerformanceMonitor.tsx",
    "src/components/common/StoreLoadingBoundary.tsx",
    "src/components/common/UnifiedSidebar.tsx",
    "src/components/deployment/DeploymentDashboard.tsx",
    "src/components/dogs/enhanced/**/*",
    "src/components/entries/EntrySyncMetrics.tsx",
    "src/components/entries/OfflineEntryForm.tsx",
    "src/components/exhibitor/RingMonitor.tsx",
    "src/components/panels/PanelManager.ts",
    "src/components/users/enhanced/**/*",
    "src/components/providers/ShowDataProvider.tsx",
    "src/components/shows/EnhancedEmptyStates.tsx",
    "src/context/EnhancedAuthProvider.tsx",
    "src/hooks/animations/usePageTransition.ts",
    "src/hooks/optimized/usePerformanceMonitor.ts",
    "src/hooks/ui/useFormState.ts",
    "src/hooks/usePerformanceOptimization.ts",
    "src/hooks/usePushNotifications.ts",
    "src/hooks/useRBAC.ts",
    "src/hooks/useRealTimeUpdates.ts",
    "src/hooks/useSearchWorker.ts",
    "src/lib/networkUtils.ts",
    "src/pages/admin/permissions/SecurityDashboardPage.tsx",
    "src/pages/BrowseShowsPage.tsx",
    "src/providers/StoreProvider.tsx",
    "src/routes/utils/SuspenseWrapper.tsx",
    "src/services/data-scoping/role-profiles.ts",
    "src/services/database/connection.ts",
    "src/services/database/storage-adapter-factory.ts",
    "src/services/performance/RealUserMonitoring.ts",
    "src/store/compositions/StoreComposition.ts",
    "src/utils/dev-cache-bypass.ts",
