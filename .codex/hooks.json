{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm qa:e2e-map:check",
            "timeout": 15,
            "statusMessage": "Checking E2E suite map..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/qa/format-changed.sh",
            "timeout": 30,
            "statusMessage": "Formatting changed files..."
          }
        ]
      }
    ]
  }
}
