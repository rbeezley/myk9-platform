import React, { useCallback, useEffect, useState } from 'react';
import { Input } from '@/components/ui/input';
import { Textarea } from '@/components/ui/textarea';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { DateTimePicker } from '@/components/ui/date-time-picker';
import { Popover, PopoverContent, PopoverTrigger } from '@/components/ui/popover';
import { Button } from '@/components/ui/button';
import { X, User, Search, Plus, Loader2, CheckCircle } from 'lucide-react';
import { format, isAfter, isBefore, addDays } from 'date-fns';
import { AppleFormField, AppleFormGrid } from '@/components/ui/AppleDialog';
import { useWizardStore } from '@/store/wizardStore';
import { useClubStore } from '@/store/clubStore';
import { usePeopleStore } from '@/store/peopleStore';
import { Badge } from '@/components/ui/badge';
import { usePanelManager } from '@/components/panels/PanelContext';
import { PanelTestComponent } from '@/components/panels/PanelTestComponent';

interface ShowDetailsStepProps {
  className?: string;
}

const SHOW_TYPES = [
  { value: 'AKC', label: 'AKC (American Kennel Club)' },
  { value: 'UKC', label: 'UKC (United Kennel Club)' },
  { value: 'NASDA', label: 'NASDA (North American Sport Dog Association)' },
  { value: 'Other', label: 'Other' },
];

export const ShowDetailsStep: React.FC<ShowDetailsStepProps> = ({ className }) => {
  const wizardState = useWizardStore();
  const { show, updateShowData, markStepCompleted, addJudgeToShow, removeJudgeFromShow, judgeDetails } = wizardState;
  const { clubs } = useClubStore();
  const { people } = usePeopleStore();
  const panelManager = usePanelManager();
  
  // Club creation state
  const [clubCreationState, setClubCreationState] = useState<{
    isCreating: boolean;
    recentlyCreated: string | null; // Club ID
    creationSuccess: boolean;
  }>({
    isCreating: false,
    recentlyCreated: null,
    creationSuccess: false,
  });

  // Person creation state
  const [personCreationState, setPersonCreationState] = useState<{
    chairman: { isCreating: boolean; recentlyCreated: string | null; creationSuccess: boolean; };
    secretary: { isCreating: boolean; recentlyCreated: string | null; creationSuccess: boolean; };
  }>({
    chairman: { isCreating: false, recentlyCreated: null, creationSuccess: false },
    secretary: { isCreating: false, recentlyCreated: null, creationSuccess: false },
  });

  // Club search state
  const [clubSearchTerm, setClubSearchTerm] = useState('');
  const [showClubSearch, setShowClubSearch] = useState(false);

  // Filter clubs based on search term
  const filteredClubs = React.useMemo(() => {
    if (!clubSearchTerm.trim()) return clubs;
    return clubs.filter(club =>
      club.name.toLowerCase().includes(clubSearchTerm.toLowerCase()) ||
      club.email.toLowerCase().includes(clubSearchTerm.toLowerCase()) ||
      `${club.address.city}, ${club.address.state}`.toLowerCase().includes(clubSearchTerm.toLowerCase())
    );
  }, [clubs, clubSearchTerm]);
  

  // Handler for opening club creation panel
  const handleCreateClub = () => {
    setClubCreationState(prev => ({ ...prev, isCreating: true, creationSuccess: false }));
    
    panelManager.openPanel({
      type: 'club',
      title: 'Create New Club',
      subtitle: 'Add a new club to host this show',
      context: {
        entityType: 'club',
        mode: 'create',
        selectionCallback: (club) => {
          // Automatically select the newly created club
          updateShowData({ clubId: club.id });
          
          // Update success state
          setClubCreationState({
            isCreating: false,
            recentlyCreated: club.id,
            creationSuccess: true,
          });
          
          console.log('🎉 Club created and selected:', club.name);
          
          // Clear success indicator after 3 seconds
          setTimeout(() => {
            setClubCreationState(prev => ({ 
              ...prev, 
              creationSuccess: false, 
              recentlyCreated: null 
            }));
          }, 3000);
        },
      },
      size: 'lg',
    });
  };

  // Handler for creating chairman
  const handleCreateChairman = () => {
    setPersonCreationState(prev => ({ 
      ...prev, 
      chairman: { isCreating: true, recentlyCreated: null, creationSuccess: false }
    }));
    
    panelManager.openPanel({
      type: 'person',
      title: 'Create New Chairman',
      subtitle: 'Add a new person to serve as show chairman',
      context: {
        entityType: 'person',
        mode: 'create',
        preFilledData: {
          role: 'secretary', // Use secretary role for chairman (same permissions)
          roleLabel: 'Chairman'
        },
        selectionCallback: (person) => {
          // Automatically select the newly created person as chairman
          updateShowData({ chairman: `${person.firstName} ${person.lastName}` });
          
          // Update success state
          setPersonCreationState(prev => ({
            ...prev,
            chairman: {
              isCreating: false,
              recentlyCreated: person.id,
              creationSuccess: true,
            }
          }));
          
          console.log('🎉 Chairman created and selected:', `${person.firstName} ${person.lastName}`);
          
          // Clear success indicator after 3 seconds
          setTimeout(() => {
            setPersonCreationState(prev => ({ 
              ...prev, 
              chairman: { 
                ...prev.chairman, 
                creationSuccess: false, 
                recentlyCreated: null 
              }
            }));
          }, 3000);
        },
      },
      size: 'lg',
    });
  };

  // Handler for creating secretary
  const handleCreateSecretary = () => {
    setPersonCreationState(prev => ({ 
      ...prev, 
      secretary: { isCreating: true, recentlyCreated: null, creationSuccess: false }
    }));
    
    panelManager.openPanel({
      type: 'person',
      title: 'Create New Secretary',
      subtitle: 'Add a new person to serve as show secretary',
      context: {
        entityType: 'person',
        mode: 'create',
        preFilledData: {
          role: 'secretary',
          roleLabel: 'Secretary'
        },
        selectionCallback: (person) => {
          // Automatically select the newly created person as secretary
          updateShowData({ secretary: `${person.firstName} ${person.lastName}` });
          
          // Update success state
          setPersonCreationState(prev => ({
            ...prev,
            secretary: {
              isCreating: false,
              recentlyCreated: person.id,
              creationSuccess: true,
            }
          }));
          
          console.log('🎉 Secretary created and selected:', `${person.firstName} ${person.lastName}`);
          
          // Clear success indicator after 3 seconds
          setTimeout(() => {
            setPersonCreationState(prev => ({ 
              ...prev, 
              secretary: { 
                ...prev.secretary, 
                creationSuccess: false, 
                recentlyCreated: null 
              }
            }));
          }, 3000);
        },
      },
      size: 'lg',
    });
  };

  // Handle panel close (including cancel)
  React.useEffect(() => {
    const cleanup = panelManager.onPanelResult((panelId, result) => {
      if (result.action === 'cancel') {
        // Reset club creation state
        setClubCreationState(prev => ({ 
          ...prev, 
          isCreating: false, 
          creationSuccess: false 
        }));
        
        // Reset person creation states
        setPersonCreationState(prev => ({
          chairman: { 
            ...prev.chairman, 
            isCreating: false, 
            creationSuccess: false 
          },
          secretary: { 
            ...prev.secretary, 
            isCreating: false, 
            creationSuccess: false 
          },
        }));
      }
    });

    return cleanup;
  }, []);
  
  // Local state for date pickers
  const [startDate, setStartDate] = useState<Date | undefined>(
    show.startDate ? new Date(show.startDate) : undefined
  );
  const [endDate, setEndDate] = useState<Date | undefined>(
    show.endDate ? new Date(show.endDate) : undefined
  );
  const [entryOpenDate, setEntryOpenDate] = useState<Date | undefined>(
    show.entryOpenDate ? new Date(show.entryOpenDate) : undefined
  );
  const [entryCloseDate, setEntryCloseDate] = useState<Date | undefined>(
    show.entryCloseDate ? new Date(show.entryCloseDate) : undefined
  );
  
  // Judge selection state
  const [judgeSelectOpen, setJudgeSelectOpen] = useState(false);
  const [judgeSearchTerm, setJudgeSearchTerm] = useState('');

  // Validation state
  const [errors, setErrors] = useState<Record<string, string>>({});

  // Form validation
  const validateForm = useCallback(() => {
    const newErrors: Record<string, string> = {};

    if (!show.name || !show.name.trim()) {
      newErrors.name = 'Show name is required';
    }

    if (!show.type) {
      newErrors.type = 'Show type is required';
    }

    if (!startDate) {
      newErrors.startDate = 'Start date is required';
    }

    if (!endDate) {
      newErrors.endDate = 'End date is required';
    } else if (startDate && isAfter(startDate, endDate)) {
      newErrors.endDate = 'End date must be after start date';
    }

    if (!entryOpenDate) {
      newErrors.entryOpenDate = 'Entry open date is required';
    }

    if (!entryCloseDate) {
      newErrors.entryCloseDate = 'Entry close date is required';
    } else if (entryOpenDate && isAfter(entryOpenDate, entryCloseDate)) {
      newErrors.entryCloseDate = 'Entry close date must be after entry open date';
    } else if (startDate && isAfter(entryCloseDate, startDate)) {
      newErrors.entryCloseDate = 'Entry close date must be before show start date';
    }

    if (!show.location || !show.location.trim()) {
      newErrors.location = 'Location is required';
    }

    if (!show.clubId) {
      newErrors.clubId = 'Club selection is required';
    }

    if (!show.chairman || !show.chairman.trim()) {
      newErrors.chairman = 'Show chairman is required';
    }

    if (!show.secretary || !show.secretary.trim()) {
      newErrors.secretary = 'Show secretary is required';
    }

    if ((show.preEntryFee ?? 0) < 0) {
      newErrors.preEntryFee = 'Pre-entry fee must be a positive number';
    }

    if ((show.dayOfShowFee ?? 0) < 0) {
      newErrors.dayOfShowFee = 'Day of show fee must be a positive number';
    }


    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  }, [show.name, show.type, show.location, show.clubId, show.chairman, show.secretary, show.preEntryFee, show.dayOfShowFee, startDate, endDate, entryOpenDate, entryCloseDate]);

  // Auto-validate and mark step complete when form is valid
  useEffect(() => {
    if (validateForm()) {
      markStepCompleted(0);
    }
  }, [show, startDate, endDate, entryOpenDate, entryCloseDate, markStepCompleted]);

  // Handle date changes
  const handleStartDateChange = (date: Date | undefined) => {
    setStartDate(date);
    updateShowData({ startDate: date ? format(date, "yyyy-MM-dd'T'HH:mm:ss") : '' });
    
    // Auto-adjust end date if it's before start date
    if (date && endDate && isBefore(endDate, date)) {
      const newEndDate = addDays(date, 1);
      setEndDate(newEndDate);
      updateShowData({ endDate: format(newEndDate, "yyyy-MM-dd'T'HH:mm:ss") });
    }
  };

  const handleEndDateChange = (date: Date | undefined) => {
    setEndDate(date);
    updateShowData({ endDate: date ? format(date, "yyyy-MM-dd'T'HH:mm:ss") : '' });
  };

  const handleEntryOpenDateChange = (date: Date | undefined) => {
    setEntryOpenDate(date);
    updateShowData({ entryOpenDate: date ? format(date, "yyyy-MM-dd'T'HH:mm:ss") : '' });
    
    // Auto-adjust entry close date if it's before open date
    if (date && entryCloseDate && isBefore(entryCloseDate, date)) {
      const newCloseDate = addDays(date, 7); // Default to 1 week later
      setEntryCloseDate(newCloseDate);
      updateShowData({ entryCloseDate: format(newCloseDate, "yyyy-MM-dd'T'HH:mm:ss") });
    }
  };

  const handleEntryCloseDateChange = (date: Date | undefined) => {
    setEntryCloseDate(date);
    updateShowData({ entryCloseDate: date ? format(date, "yyyy-MM-dd'T'HH:mm:ss") : '' });
  };

  return (
    <div className={className}>
      <div className="space-y-8">
        <div className="max-w-4xl mx-auto space-y-8">
          {/* Show Name - Full Width */}
          <AppleFormGrid columns={1}>
            <AppleFormField label="Show Name" required error={errors.name}>
              <Input
                value={show.name}
                onChange={(e) => updateShowData({ name: e.target.value })}
                placeholder="e.g., Spring Specialty Show 2024"
                className="form-input h-10"
              />
            </AppleFormField>
          </AppleFormGrid>

          {/* Show Type and Club */}
          <AppleFormGrid columns={2} className="gap-6">
            <AppleFormField label="Show Type" required error={errors.type}>
              <Select value={show.type} onValueChange={(value) => updateShowData({ type: value as typeof show.type })}>
                <SelectTrigger className="form-input h-10">
                  <SelectValue placeholder="Select show type" />
                </SelectTrigger>
                <SelectContent>
                  {SHOW_TYPES.map((type) => (
                    <SelectItem key={type.value} value={type.value}>
                      {type.label}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </AppleFormField>

            <AppleFormField label="Hosting Club" required error={errors.clubId}>
              <div className="space-y-2 wizard-form-field">
                <div className="relative">
                  <Select 
                    value={show.clubId} 
                    onValueChange={(value) => updateShowData({ clubId: value })}
                  >
                    <SelectTrigger className="form-input h-10">
                      <SelectValue placeholder="Select club" />
                    </SelectTrigger>
                    <SelectContent>
                      <div className="p-2 border-b">
                        <div className="relative">
                          <Search className="absolute left-2 top-2.5 h-4 w-4 text-muted-foreground" />
                          <Input
                            placeholder="Search clubs..."
                            value={clubSearchTerm}
                            onChange={(e) => setClubSearchTerm(e.target.value)}
                            className="pl-8 h-8 text-sm"
                            autoFocus={false}
                          />
                        </div>
                      </div>
                      {filteredClubs.length > 0 ? (
                        filteredClubs.map((club) => (
                          <SelectItem key={club.id} value={club.id}>
                            <div className="flex flex-col">
                              <span className="font-medium">{club.name}</span>
                              <span className="text-xs text-muted-foreground">
                                {club.address.city}, {club.address.state}
                              </span>
                            </div>
                          </SelectItem>
                        ))
                      ) : (
                        <div className="p-2 text-sm text-muted-foreground text-center">
                          {clubSearchTerm ? 'No clubs found matching your search' : 'No clubs available'}
                        </div>
                      )}
                    </SelectContent>
                  </Select>
                </div>
                <Button
                  type="button"
                  variant="outline"
                  size="sm"
                  onClick={handleCreateClub}
                  disabled={clubCreationState.isCreating}
                  className={`w-full gap-2 transition-all duration-300 h-10 ${
                    clubCreationState.creationSuccess
                      ? 'text-green-600 border-green-200 bg-green-50 hover:bg-green-100 shadow-sm'
                      : 'text-primary border-primary/20 hover:bg-primary/5 hover:border-primary/30'
                  }`}
                >
                  {clubCreationState.isCreating ? (
                    <>
                      <Loader2 className="h-4 w-4 animate-spin" />
                      Creating Club...
                    </>
                  ) : clubCreationState.creationSuccess ? (
                    <>
                      <CheckCircle className="h-4 w-4" />
                      Club Created!
                    </>
                  ) : (
                    <>
                      <Plus className="h-4 w-4" />
                      Create New Club
                    </>
                  )}
                </Button>
              </div>
            </AppleFormField>
          </AppleFormGrid>

          {/* Chairman and Secretary */}
          <AppleFormGrid columns={2} className="gap-6">
            <AppleFormField label="Show Chairman" required error={errors.chairman}>
              <div className="space-y-2 wizard-form-field">
                <div className="relative">
                  <Select value={show.chairman || ''} onValueChange={(value) => updateShowData({ chairman: value })}>
                    <SelectTrigger className="form-input h-10">
                      <SelectValue placeholder="Select show chairman" />
                    </SelectTrigger>
                    <SelectContent>
                      {people.length > 0 ? (
                        people.map((person) => (
                          <SelectItem key={person.id} value={`${person.firstName} ${person.lastName}`}>
                            {person.firstName} {person.lastName}
                          </SelectItem>
                        ))
                      ) : (
                        <div className="p-2 text-sm text-muted-foreground text-center">
                          No people available
                        </div>
                      )}
                    </SelectContent>
                  </Select>
                </div>
                <Button
                  type="button"
                  variant="outline" 
                  size="sm"
                  onClick={handleCreateChairman}
                  disabled={personCreationState.chairman.isCreating}
                  className={`w-full gap-2 transition-all duration-300 h-10 ${
                    personCreationState.chairman.creationSuccess
                      ? 'text-green-600 border-green-200 bg-green-50 hover:bg-green-100 shadow-sm'
                      : 'text-primary border-primary/20 hover:bg-primary/5 hover:border-primary/30'
                  }`}
                >
                  {personCreationState.chairman.isCreating ? (
                    <>
                      <Loader2 className="h-4 w-4 animate-spin" />
                      Creating Chairman...
                    </>
                  ) : personCreationState.chairman.creationSuccess ? (
                    <>
                      <CheckCircle className="h-4 w-4" />
                      Chairman Created!
                    </>
                  ) : (
                    <>
                      <Plus className="h-4 w-4" />
                      Create New Chairman
                    </>
                  )}
                </Button>
              </div>
            </AppleFormField>

            <AppleFormField label="Show Secretary" required error={errors.secretary}>
              <div className="space-y-2 wizard-form-field">
                <div className="relative">
                  <Select value={show.secretary || ''} onValueChange={(value) => updateShowData({ secretary: value })}>
                    <SelectTrigger className="form-input h-10">
                      <SelectValue placeholder="Select show secretary" />
                    </SelectTrigger>
                    <SelectContent>
                      {people.length > 0 ? (
                        people.map((person) => (
                          <SelectItem key={person.id} value={`${person.firstName} ${person.lastName}`}>
                            {person.firstName} {person.lastName}
                          </SelectItem>
                        ))
                      ) : (
                        <div className="p-2 text-sm text-muted-foreground text-center">
                          No people available
                        </div>
                      )}
                    </SelectContent>
                  </Select>
                </div>
                <Button
                  type="button"
                  variant="outline"
                  size="sm"
                  onClick={handleCreateSecretary}
                  disabled={personCreationState.secretary.isCreating}
                  className={`w-full gap-2 transition-all duration-300 h-10 ${
                    personCreationState.secretary.creationSuccess
                      ? 'text-green-600 border-green-200 bg-green-50 hover:bg-green-100 shadow-sm'
                      : 'text-primary border-primary/20 hover:bg-primary/5 hover:border-primary/30'
                  }`}
                >
                  {personCreationState.secretary.isCreating ? (
                    <>
                      <Loader2 className="h-4 w-4 animate-spin" />
                      Creating Secretary...
                    </>
                  ) : personCreationState.secretary.creationSuccess ? (
                    <>
                      <CheckCircle className="h-4 w-4" />
                      Secretary Created!
                    </>
                  ) : (
                    <>
                      <Plus className="h-4 w-4" />
                      Create New Secretary
                    </>
                  )}
                </Button>
              </div>
            </AppleFormField>
          </AppleFormGrid>

          {/* Start and End Dates */}
          <AppleFormGrid columns={2} className="gap-6">
            <AppleFormField label="Start Date & Time" required error={errors.startDate}>
              <DateTimePicker
                value={startDate}
                onChange={handleStartDateChange}
                placeholder="Pick start date and time"
                className="h-10"
                minDate={new Date()}
                showTime={true}
                timeFormat="12h"
              />
            </AppleFormField>

            <AppleFormField label="End Date & Time" required error={errors.endDate}>
              <DateTimePicker
                value={endDate}
                onChange={handleEndDateChange}
                placeholder="Pick end date and time"
                className="h-10"
                minDate={startDate || new Date()}
                showTime={true}
                timeFormat="12h"
              />
            </AppleFormField>
          </AppleFormGrid>

          {/* Entry Open and Close Dates */}
          <AppleFormGrid columns={2} className="gap-6">
            <AppleFormField label="Entry Open Date & Time" required error={errors.entryOpenDate}>
              <DateTimePicker
                value={entryOpenDate}
                onChange={handleEntryOpenDateChange}
                placeholder="Pick entry open date and time"
                className="h-10"
                minDate={new Date()}
                maxDate={startDate}
                showTime={true}
                timeFormat="12h"
              />
            </AppleFormField>

            <AppleFormField label="Entry Close Date & Time" required error={errors.entryCloseDate}>
              <DateTimePicker
                value={entryCloseDate}
                onChange={handleEntryCloseDateChange}
                placeholder="Pick entry close date and time"
                className="h-10"
                minDate={entryOpenDate || new Date()}
                maxDate={startDate}
                showTime={true}
                timeFormat="12h"
              />
            </AppleFormField>
          </AppleFormGrid>

          {/* Entry Fees */}
          <AppleFormGrid columns={2} className="gap-6">
            <AppleFormField label="Pre-Entry Fee" error={errors.preEntryFee}>
              <div className="relative">
                <span className="absolute left-3 top-1/2 transform -translate-y-1/2 text-muted-foreground pr-1">$</span>
                <Input
                  type="number"
                  value={show.preEntryFee || ''}
                  onChange={(e) => updateShowData({ preEntryFee: parseFloat(e.target.value) || 0 })}
                  placeholder="0.00"
                  className="form-input h-10 pl-10"
                  min="0"
                  step="0.01"
                />
              </div>
            </AppleFormField>

            <AppleFormField label="Day of Show Fee" error={errors.dayOfShowFee}>
              <div className="relative">
                <span className="absolute left-3 top-1/2 transform -translate-y-1/2 text-muted-foreground pr-1">$</span>
                <Input
                  type="number"
                  value={show.dayOfShowFee || ''}
                  onChange={(e) => updateShowData({ dayOfShowFee: parseFloat(e.target.value) || 0 })}
                  placeholder="0.00"
                  className="form-input h-10 pl-10"
                  min="0"
                  step="0.01"
                />
              </div>
            </AppleFormField>
          </AppleFormGrid>

          {/* Location - Full Width */}
          <AppleFormGrid columns={1}>
            <AppleFormField label="Location/Venue" required error={errors.location}>
              <Textarea
                value={show.location}
                onChange={(e) => updateShowData({ location: e.target.value })}
                placeholder="Enter venue name and address"
                className="form-input min-h-[80px]"
                rows={3}
              />
            </AppleFormField>
          </AppleFormGrid>

          {/* Judge Selection */}
          <AppleFormGrid columns={1}>
            <AppleFormField label="Assigned Judges">
              <div className="space-y-4">
                {/* Selected Judges */}
                {show.judgeIds.length > 0 && (
                  <div className="bg-gradient-to-r from-blue-50/80 to-indigo-50/80 dark:from-blue-950/20 dark:to-indigo-950/20 border border-blue-200/60 dark:border-blue-800/50 rounded-xl p-5 backdrop-blur-sm">
                    <div className="flex items-center justify-between mb-4">
                      <h4 className="text-sm font-semibold text-blue-900 dark:text-blue-100">
                        Selected Judges ({show.judgeIds.length})
                      </h4>
                      <Badge variant="outline" className="text-blue-700 dark:text-blue-300 border-blue-300 dark:border-blue-700 px-3 py-1">
                        {show.judgeIds.length} judge{show.judgeIds.length !== 1 ? 's' : ''}
                      </Badge>
                    </div>
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                      {show.judgeIds.map((judgeId) => {
                        const judgeDetail = judgeDetails[judgeId];
                        return (
                          <div key={judgeId} className="bg-card rounded-xl border border-blue-200/60 dark:border-blue-800/50 p-4 shadow-sm backdrop-blur-sm">
                            <div className="flex items-center justify-between">
                              <div className="flex items-center gap-2">
                                <div className="w-8 h-8 bg-blue-100 dark:bg-blue-900/50 rounded-full flex items-center justify-center">
                                  <User className="h-4 w-4 text-blue-600 dark:text-blue-400" />
                                </div>
                                <div className="flex-1">
                                  <div className="font-medium text-foreground text-sm">
                                    {judgeDetail?.name || 'Unknown Judge'}
                                  </div>
                                  {judgeDetail?.email && (
                                    <div className="text-xs text-muted-foreground">
                                      {judgeDetail.email}
                                    </div>
                                  )}
                                </div>
                              </div>
                              <button
                                type="button"
                                onClick={() => removeJudgeFromShow(judgeId)}
                                className="w-6 h-6 text-muted-foreground hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-950/50 rounded-full flex items-center justify-center transition-colors"
                                title="Remove judge"
                              >
                                <X className="h-3 w-3" />
                              </button>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                )}
                
                {/* Judge Selector */}
                <Popover open={judgeSelectOpen} onOpenChange={setJudgeSelectOpen}>
                  <PopoverTrigger asChild>
                    <Button
                      variant="outline"
                      className="w-full justify-start text-left font-normal h-14 border-2 border-dashed border-border hover:border-blue-400 hover:bg-blue-50 dark:hover:bg-blue-950/20 transition-all duration-300 rounded-xl"
                    >
                      <div className="flex items-center gap-3">
                        <div className="w-8 h-8 bg-blue-100 dark:bg-blue-900/50 rounded-full flex items-center justify-center">
                          <User className="h-4 w-4 text-blue-600 dark:text-blue-400" />
                        </div>
                        <div>
                          <div className="font-medium text-foreground">
                            {show.judgeIds.length === 0 
                              ? "Add judges to this show" 
                              : "Add more judges"
                            }
                          </div>
                          <div className="text-xs text-muted-foreground">
                            {show.judgeIds.length === 0 
                              ? "Select people who will judge classes" 
                              : `${show.judgeIds.length} judge${show.judgeIds.length !== 1 ? 's' : ''} already selected`
                            }
                          </div>
                        </div>
                      </div>
                    </Button>
                  </PopoverTrigger>
                  <PopoverContent className="w-[400px] p-4">
                    <div className="space-y-4">
                      {/* Search Input */}
                      <div className="flex items-center space-x-2">
                        <Search className="h-4 w-4 text-muted-foreground" />
                        <Input
                          placeholder="Search people..."
                          value={judgeSearchTerm}
                          onChange={(e) => setJudgeSearchTerm(e.target.value)}
                          className="flex-1"
                        />
                      </div>
                      
                      {/* People List */}
                      <div className="max-h-[300px] overflow-auto space-y-1">
                        {people
                          .filter(person => !show.judgeIds.includes(String(person.id)))
                          .filter(person => {
                            const fullName = `${person.firstName} ${person.lastName}`;
                            return judgeSearchTerm === '' || 
                              fullName.toLowerCase().includes(judgeSearchTerm.toLowerCase()) ||
                              (person.email && person.email.toLowerCase().includes(judgeSearchTerm.toLowerCase()))
                          })
                          .map((person) => {
                            const personId = String(person.id);
                            return (
                              <button
                                key={personId}
                                type="button"
                                onClick={() => {
                                  const fullName = `${person.firstName} ${person.lastName}`;
                                  console.log('Selecting judge:', fullName, personId);
                                  const judgeData = {
                                    name: fullName,
                                    email: person.email || '',
                                    phone: person.phone || ''
                                  };
                                  console.log('Adding judge with data:', { personId, judgeData });
                                  addJudgeToShow(personId, judgeData);
                                  setJudgeSelectOpen(false);
                                  setJudgeSearchTerm('');
                                  
                                  // Debug: Check state after adding
                                  setTimeout(() => {
                                    const { judgeDetails: updatedDetails } = useWizardStore.getState();
                                    console.log('Judge details after adding:', updatedDetails);
                                  }, 100);
                                }}
                                className="w-full flex items-center gap-3 p-2 rounded-md hover:bg-accent hover:text-accent-foreground transition-colors cursor-pointer text-left"
                              >
                                <User className="h-4 w-4 flex-shrink-0" />
                                <div className="flex-1 min-w-0">
                                  <div className="font-medium truncate">{person.firstName} {person.lastName}</div>
                                  {person.email && (
                                    <div className="text-xs text-muted-foreground truncate">{person.email}</div>
                                  )}
                                </div>
                              </button>
                            );
                          })}
                        
                        {people.filter(person => !show.judgeIds.includes(String(person.id))).length === 0 && (
                          <div className="text-center py-6 text-sm text-muted-foreground">
                            No more people available to add as judges
                          </div>
                        )}
                        
                        {people
                          .filter(person => !show.judgeIds.includes(String(person.id)))
                          .filter(person => {
                            const fullName = `${person.firstName} ${person.lastName}`;
                            return judgeSearchTerm !== '' && (
                              fullName.toLowerCase().includes(judgeSearchTerm.toLowerCase()) ||
                              (person.email && person.email.toLowerCase().includes(judgeSearchTerm.toLowerCase()))
                            )
                          }).length === 0 && judgeSearchTerm !== '' && (
                          <div className="text-center py-6 text-sm text-muted-foreground">
                            No people found matching "{judgeSearchTerm}"
                          </div>
                        )}
                      </div>
                    </div>
                  </PopoverContent>
                </Popover>
                
                {show.judgeIds.length === 0 && (
                  <div className="text-center py-10 border-2 border-dashed border-border rounded-xl bg-muted/30 backdrop-blur-sm">
                    <div className="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
                      <User className="h-8 w-8 text-muted-foreground" />
                    </div>
                    <h3 className="text-base font-semibold text-foreground mb-2">
                      No judges assigned yet
                    </h3>
                    <p className="text-sm text-muted-foreground max-w-sm mx-auto">
                      Select judges who will be available to judge classes at this show.
                    </p>
                  </div>
                )}
              </div>
            </AppleFormField>
          </AppleFormGrid>

          {/* Validation Summary */}
          {Object.keys(errors).length > 0 && (
            <div className="rounded-xl bg-destructive/10 border border-destructive/20 p-6 backdrop-blur-sm">
              <div className="flex items-start gap-3">
                <div className="w-5 h-5 rounded-full bg-destructive/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <span className="text-destructive text-xs font-bold">!</span>
                </div>
                <div className="flex-1">
                  <p className="text-sm font-semibold text-destructive mb-3">
                    Please fix the following errors to continue:
                  </p>
                  <ul className="text-sm text-destructive space-y-2">
                    {Object.values(errors).map((error, index) => (
                      <li key={index} className="flex items-start gap-2">
                        <span className="text-destructive/60 mt-1">•</span>
                        <span>{error}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          )}

          {/* Development: Panel Testing Section */}
          {process.env.NODE_ENV === 'development' && (
            <div className="mt-12 p-6 bg-muted/30 rounded-xl border-2 border-dashed border-muted-foreground/20 backdrop-blur-sm">
              <div className="flex items-center gap-2 mb-4">
                <span className="text-lg">🧪</span>
                <h4 className="text-base font-semibold text-muted-foreground">
                  Development Panel Testing
                </h4>
              </div>
              <PanelTestComponent />
            </div>
          )}
        </div>
      </div>
    </div>
  );
};

export default ShowDetailsStep;