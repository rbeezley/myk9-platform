e" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert h-4 w-4" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg><div class="text-sm [&amp;_p]:leading-relaxed">This entry will be free. No entry fees are charged.</div></div><div><label class="text-xs font-medium leading-tight tracking-wide uppercase text-muted-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-50 peer-disabled:text-muted-foreground peer-focus-visible:text-foreground peer-focus-visible:font-semibold transition-colors duration-200 ease-apple" for="waiver-reason">Why is this entry free?</label><textarea class="flex min-h-[60px] w-full rounded-md border border-input aria-invalid:border-destructive bg-card px-3 py-2 text-base shadow-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary disabled:cursor-not-allowed disabled:opacity-50 md:text-sm" id="waiver-reason" placeholder="For example, a judge or worker entry" required=""></textarea></div></div></div></div></div></div><div class="rounded-xl border border-border/50 bg-card text-card-foreground shadow-card backdrop-blur-sm" role="region" aria-labelledby="secretary-desk-payment-title"><div class="flex flex-col space-y-1.5 p-6"><h3 class="font-semibold tracking-tight text-base flex items-center gap-2" id="secretary-desk-payment-title"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-receipt h-4 w-4" aria-hidden="true"><path d="M12 17V7"></path><path d="M16 8h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4H8"></path><path d="M4 3a1 1 0 0 1 1-1 1.3 1.3 0 0 1 .7.2l.933.6a1.3 1.3 0 0 0 1.4 0l.934-.6a1.3 1.3 0 0 1 1.4 0l.933.6a1.3 1.3 0 0 0 1.4 0l.933-.6a1.3 1.3 0 0 1 1.4 0l.934.6a1.3 1.3 0 0 0 1.4 0l.933-.6A1.3 1.3 0 0 1 19 2a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1 1.3 1.3 0 0 1-.7-.2l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.934.6a1.3 1.3 0 0 1-1.4 0l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-1.4 0l-.934-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-.7.2 1 1 0 0 1-1-1z"></path></svg>Payment at the desk</h3></div><div class="p-6 pt-0 space-y-4"><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><button type="button" aria-pressed="false" class="inline-flex items-center gap-2 whitespace-nowrap font-medium text-sm rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 transition-all duration-150 ease-out hover:-translate-y-[1px] active:translate-y-0 disabled:pointer-events-none disabled:opacity-50 disabled:translate-y-0 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 border border-border bg-secondary text-secondary-foreground hover:bg-muted h-11 px-6 py-2 justify-start"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check h-4 w-4 mr-2" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Paid by cash or check</button><button type="button" aria-pressed="true" class="inline-flex items-center gap-2 whitespace-nowrap font-medium text-sm rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 transition-all duration-150 ease-out hover:-translate-y-[1px] active:translate-y-0 disabled:pointer-events-none disabled:opacity-50 disabled:translate-y-0 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-primary text-primary-foreground hover:opacity-90 h-11 px-6 py-2 justify-start"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-lin