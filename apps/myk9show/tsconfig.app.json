{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // Incremental for every caller (`typecheck:app`, the build:* scripts, a bare
    // `tsc -p tsconfig.app.json`). Configs that extend this one name their own file (MYK9-1482).
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/app.tsbuildinfo",
    "jsx": "react-jsx",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    /* Re-enabled 2026-02-03 - Sprint 25: Type Safety Focus */
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    /* Core Safety Features */
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    /* Temporarily Disabled for Gradual Migration */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false,
    /* Re-enabled 2025-01-17 - fixing implicit any types incrementally */
    "noImplicitAny": true
  },
  "include": ["src"],
  "exclude": [
    "src/test/**/*",
    "src/**/__tests__/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",

    "src/sw-custom.ts",

    "src/services/sync/**/*",
    "src/hooks/useBackgroundSync.ts",

    "src/store/offlineScoringStore.ts",

    "src/services/performance/RealUserMonitoring.ts",
    "src/components/admin/LoadTestDashboard.tsx",
    "src/hooks/optimized/usePerformanceMonitor.ts",
    "src/utils/realtimeOptimization.ts",

    "src/components/admin/DataLifecycleManagement.tsx",
    "src/components/common/LazyComponents.tsx",
    "src/components/common/ErrorBoundary.tsx",
    "src/components/shows/RegistrationWorkflow/**/*",
    "src/components/trials/TrialDetail/TrialClassesCards.tsx",
    "src/components/clubs/ClubDetails.tsx",

    "src/hooks/useRBAC.ts",
    "src/hooks/useRealTimeUpdates.ts",
    "src/hooks/useExistingEntries.ts",
    "src/hooks/useDraftPersistence.ts",
    "src/hooks/optimized/useSimplifiedHooks.ts",
    "src/hooks/queries/useJudgeDatabase.ts",

    "src/services/error/GlobalErrorHandler.ts",
    "src/services/database/connection.ts",
    "src/services/database/migrations.ts",
    "src/services/data-scoping/role-profiles.ts",
    "src/store/compositions/StoreComposition.ts",

    "src/pages/BrowseShowsPage.tsx",

    "src/providers/StoreProvider.tsx",
    "src/routes/utils/SuspenseWrapper.tsx",

    "src/lib/networkUtils.ts"
  ]
}
