{
  "name": "@myk9/q",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:analyze": "cross-env ANALYZE=true vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:coverage": "vitest --coverage",
    "test:offline-first": "vitest run --coverage useOptimisticScoring EntryList offline-first-pattern-consistency",
    "setup": "node scripts/setup-dev.cjs",
    "parse:rules": "tsx scripts/parse-akc-rulebook.ts",
    "seed:rules": "tsx scripts/seed-akc-rules.ts",
    "validate:rules": "tsx scripts/validate-rules-accuracy.ts",
    "test:e2e": "npx playwright test --config=playwright.e2e.config.ts",
    "test:e2e:ui": "npx playwright test --config=playwright.e2e.config.ts --ui",
    "test:e2e:headed": "npx playwright test --config=playwright.e2e.config.ts --headed",
    "test:e2e:debug": "npx playwright test --config=playwright.e2e.config.ts --debug",
    "test:e2e:prod": "cross-env PROD_PASSCODE=AAC99 npx playwright test --config=playwright.prod.config.ts",
    "test:e2e:prod:headed": "cross-env PROD_PASSCODE=AAC99 npx playwright test --config=playwright.prod.config.ts --headed",
    "test:e2e:ci": "npx playwright test --config=playwright.ci.config.ts",
    "playwright:install": "npx playwright install chromium"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@myk9/core": "workspace:*",
    "@myk9/pwa-update": "workspace:*",
    "@myk9/replication": "workspace:*",
    "@myk9/ringside": "workspace:*",
    "@myk9/scoring": "workspace:*",
    "@myk9/scoring-ui": "workspace:*",
    "@myk9/secretary": "workspace:*",
    "@myk9/supabase": "workspace:*",
    "@myk9/ui": "workspace:*",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/query-sync-storage-persister": "^5.100.14",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-persist-client": "^5.100.14",
    "@tanstack/react-virtual": "^3.13.26",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.577.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.15",
    "rollup-plugin-visualizer": "^6.0.11",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7",
    "workbox-build": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
