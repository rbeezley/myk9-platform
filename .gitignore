# Turborepo
.turbo
.superpowers/
.agents/*
!.agents/agents/
!.agents/agents/**
# Codex reads its skills from here; the eight already tracked were force-added
# past the rule above, and a new one would go untracked silently.
!.agents/skills/
!.agents/skills/**
# Local-only vendored skill (pbakaus/impeccable, reinstallable from
# skills-lock.json); stays out of the repo despite the re-includes above.
# No trailing slash, so the SYMLINK form is ignored too: the house layout is
# one real dir plus symlinks in the sibling trees, and a slash matches only
# directories. All three trees, so normalizing the layout cannot commit it.
.agents/skills/impeccable
.claude/skills/impeccable
.codex/skills/impeccable

# Local support-triage pass state (regenerated every run; safe to delete)
.support-triage/

# Per-worktree log directory for local check output (see docs/plan-dev-process-hardening-2026-09-07.md)
.logs/
