{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    /* Re-enabled 2026-02-03 - Sprint 25: Type Safety Focus */
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    /* Core Safety Features */
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    /* Temporarily Disabled for Gradual Migration */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false,
    /* Re-enabled 2025-01-17 - fixing implicit any types incrementally */
    "noImplicitAny": true
  },
  "include": ["src"],
  "exclude": [
    "src/test/**/*",
    "src/**/__tests__/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",

    "src/sw-custom.ts",

    "src/services/sync/**/*",
    "src/services/conflict/**/*",
    "src/services/realtime/**/*",
    "src/components/sync/**/*",
    "src/components/conflict/**/*",
    "src/hooks/useBackgroundSync.ts",
    "src/hooks/useRegistrationConflicts.ts",
    "src/hooks/useConflictResolution.ts",
    "src/hooks/useOptimisticUpdates.ts",

    "src/services/scoring/OfflineScoringService.ts",
    "src/components/scoring/JudgeSyncDashboard.tsx",
    "src/store/offlineScoringStore.ts",

    "src/services/performance/RealUserMonitoring.ts",
    "src/services/deployment/CDNService.ts",
    "src/services/deployment/FeatureFlagService.ts",
    "src/services/deployment/ProductionMonitoringService.ts",
    "src/services/deployment/index.ts",
    "src/components/analytics/MonitoringDashboard.tsx",
    "src/components/analytics/AnalyticsDashboard.tsx",
    "src/components/analytics/UserActivityMonitor.tsx",
    "src/components/deployment/CDNDashboard.tsx",
    "src/components/admin/PerformanceDashboard.tsx",
