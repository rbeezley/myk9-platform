{
  "$schema": "https://v2-8-0.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      // The repo-root edge functions live OUTSIDE every package dir, yet
      // apps/myk9show typechecks (tsconfig.edge-tests.json) and runs
      // (vitest.config.ts `test.include`) their tests. Without this input a
      // change to one of them is invisible to turbo's hash, so a cached hit
      // would report green on code it never looked at.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/supabase/functions/**"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/supabase/functions/**"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
