{
  "name": "myk9-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for myK9Q and myK9Show applications",
  "scripts": {
    "dev:show": "turbo dev --filter=@myk9/show",
    "dev:q": "turbo dev --filter=@myk9/q",
    "build": "turbo build",
    "build:show": "turbo build --filter=@myk9/show",
    "build:q": "turbo build --filter=@myk9/q",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:packages": "turbo test --filter=@myk9/core --filter=@myk9/replication --filter=@myk9/scoring --filter=@myk9/scoring-ui --filter=@myk9/supabase --filter=@myk9/ui",
    "test:packages:coverage": "turbo test --filter=@myk9/core --filter=@myk9/replication --filter=@myk9/scoring --filter=@myk9/scoring-ui --filter=@myk9/supabase --filter=@myk9/ui -- --coverage",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.8.0",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  }
}
