{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm typecheck 2>&1 | head -30",
            "timeout": 60,
            "statusMessage": "Running typecheck..."
          }
        ]
      }
    ]
  }
}
