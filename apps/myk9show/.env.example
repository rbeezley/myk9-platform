# Application Environment Variables

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Application Configuration
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# Public surface gate
#   'full'   — default. Full myK9Show app, all routes accessible by role.
#   'wizard' — early-access mode. Only the show-creation wizard surface
#              (marketing landing, auth, /secretary/create-show/wizard,
#              show landing pages) is reachable. Site admins bypass and
#              see the full app. Used by the waitlist-only deployment.
VITE_PUBLIC_SURFACE=full

# Logging (production only — RemoteTransport sends batched logs here)
VITE_LOG_ENDPOINT=https://sojmvhhwsjxmfistvzbe.supabase.co/functions/v1/receive-logs

# Web Push (VAPID)
# Generate with: npx web-push generate-vapid-keys
# Also set VAPID_PRIVATE_KEY + VAPID_SUBJECT in Supabase Edge Function secrets
VITE_VAPID_PUBLIC_KEY=

# Google Maps Embed API (optional)
# When set, VenueMap uses the documented Embed API which handles city/state-only
# locations reliably. Without a key it falls back to the legacy keyless embed.
# Create a key in Google Cloud Console, enable "Maps Embed API", and restrict
# it by HTTP referrer to the production/staging hostnames.
# VITE_GOOGLE_MAPS_EMBED_API_KEY=

# =================================================================
# OPTIONAL — Not needed for staging
# =================================================================

# CDN Configuration (not yet active)
# VITE_CDN_BASE_URL=https://cdn.myk9show.com
# VITE_CDN_API_URL=https://api.cdn.myk9show.com
# VITE_CDN_API_KEY=your_cdn_api_key

# Feature Flags (not yet active)
# VITE_ENABLE_FEATURE_FLAGS=true
# VITE_FEATURE_FLAG_API_URL=https://api.featureflags.myk9show.com
# VITE_FEATURE_FLAG_API_KEY=your_feature_flag_api_key

# Analytics and Monitoring (not yet active)
# VITE_ANALYTICS_ENDPOINT — when set, MonitoringService POSTs metric batches here.
# VITE_DATADOG_CLIENT_TOKEN — when set (with the Datadog RUM snippet loaded),
#   MonitoringService forwards metrics to Datadog RUM.
# VITE_ANALYTICS_ENDPOINT=https://api.myk9show.com/metrics
# VITE_DATADOG_CLIENT_TOKEN=your_datadog_client_token

# Performance Monitoring (not yet active)
# VITE_ENABLE_PERFORMANCE_MONITORING — 'true' enables MonitoringService outside DEV.
# VITE_ENABLE_PERFORMANCE_MONITORING=true

# Error Tracking — Sentry (see src/services/observability/sentry.ts)
# VITE_SENTRY_DSN — when set, Sentry is initialized.
# VITE_ERROR_TRACKING_ENABLED — 'true' (with VITE_SENTRY_DSN) enables the
#   errorTracking Sentry path.
# VITE_SENTRY_DSN=your_sentry_dsn
# VITE_ERROR_TRACKING_ENABLED=true
