# Application Environment Variables\n\n# Supabase Configuration\nVITE_SUPABASE_URL=your_supabase_project_url\nVITE_SUPABASE_ANON_KEY=your_supabase_anon_key\n\n# CDN Configuration\nVITE_CDN_BASE_URL=https://cdn.myk9show.com\nVITE_CDN_API_URL=https://api.cdn.myk9show.com\nVITE_CDN_API_KEY=your_cdn_api_key\n\n# API Configuration\nVITE_API_URL=http://localhost:3000\n\n# Application Configuration\nVITE_APP_VERSION=1.0.0\nVITE_APP_ENVIRONMENT=development\n\n# Feature Flags\nVITE_ENABLE_FEATURE_FLAGS=true\nVITE_FEATURE_FLAG_API_URL=https://api.featureflags.myk9show.com\nVITE_FEATURE_FLAG_API_KEY=your_feature_flag_api_key\n\n# Analytics and Monitoring\nVITE_ENABLE_ANALYTICS=true\nVITE_SENTRY_DSN=your_sentry_dsn\nVITE_ANALYTICS_API_KEY=your_analytics_api_key\n\n# Performance Monitoring\nVITE_ENABLE_PERFORMANCE_MONITORING=true\nVITE_WEB_VITALS_ENDPOINT=https://api.myk9show.com/vitals\n\n# Error Tracking\nVITE_ERROR_TRACKING_ENABLED=true\nVITE_ERROR_TRACKING_SAMPLE_RATE=0.1\n\n# Development Configuration\nVITE_ENABLE_DEV_TOOLS=true\nVITE_ENABLE_DEBUG_LOGS=false\n\n# Build Configuration\nVITE_BUNDLE_ANALYZER=false\nVITE_SOURCE_MAPS=true"