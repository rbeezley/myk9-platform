{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/test.tsbuildinfo",
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "src/vite-env.d.ts",
    "src/types/**/*.d.ts",
    "src/config/**/*.test.ts",
    "src/constants/**/*.test.ts",
    "src/test/*.source.test.ts",
    "src/test/branding/**/*.test.ts",
    "src/test/config/**/*.test.ts",
    "src/test/lib/templateValidation.test.ts",
    "src/test/styles/**/*.test.ts"
  ],
  "exclude": []
}
