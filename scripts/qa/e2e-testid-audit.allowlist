# e2e-testid-audit allowlist: ids an e2e spec asserts that the app builds by
# interpolation, so the static audit cannot see them. One tab-separated row:
#   <id> TAB <producer path, repo-relative> TAB <template, verbatim> TAB <reason>
# Every row is re-verified on each run (producer exists and still contains the
# template, id matches it, a spec still references it, id not statically
# present); a row that stops holding fails the audit as STALE ALLOWLIST.
result-ABS	packages/scoring-ui/src/components/ResultChoiceChips.tsx	result-${opt.value}	RESULT_OPTIONS includes ABS; atShowJudgeScoring records an absence
wizard-step-circle-0	apps/myk9show/src/components/shows/wizard/components/HorizontalProgressIndicator.tsx	wizard-step-circle-${step.id}	registration wizard step ids are the step index (useRegistrationWizardState)
wizard-step-circle-1	apps/myk9show/src/components/shows/wizard/components/HorizontalProgressIndicator.tsx	wizard-step-circle-${step.id}	registration wizard step ids are the step index (useRegistrationWizardState)
wizard-step-connector-0	apps/myk9show/src/components/shows/wizard/components/HorizontalProgressIndicator.tsx	wizard-step-connector-${step.id}	connector after the first registration wizard step (step index 0)
header-action-group-show-day	apps/myk9show/src/components/layout/HeaderActions.tsx	header-action-group-${group.id}	show-day is an ACTION_GROUP_ORDER group (actionRegistry.ts); the show page registers its tools there (MYK9-1262)
header-action-group-show-logistics	apps/myk9show/src/components/layout/HeaderActions.tsx	header-action-group-${group.id}	show-logistics is an ACTION_GROUP_ORDER group (actionRegistry.ts); the show page registers its tools there (MYK9-1262)
header-action-show-tool-incident-log	apps/myk9show/src/components/layout/HeaderActions.tsx	header-action-${action.id}	buildShowToolActions ids rows show-tool-<tool id>; incident-log is a show page tool (MYK9-1262)
header-action-page-export-entries	apps/myk9show/src/components/layout/HeaderActions.tsx	header-action-${action.id}	buildPageExportActions ids rows page-export-<export id>; Entry Forms registers its export as 'entries' (MYK9-1594)
header-action-show-add-mail-in-entry	apps/myk9show/src/components/layout/HeaderActions.tsx	header-action-${action.id}	buildShowActions' one add-entry action, id show-add-mail-in-entry (actionRegistry.ts, MYK9-1242)
header-action-show-open-entry-management	apps/myk9show/src/components/layout/HeaderActions.tsx	header-action-${action.id}	buildShowActions' Open Entry Forms action, id show-open-entry-management (actionRegistry.ts)
header-action-show-tool-entry-list-waitlist	apps/myk9show/src/components/layout/HeaderActions.tsx	header-action-${action.id}	buildShowToolActions ids rows show-tool-<tool id>; entry-list-waitlist is an Entry Forms entry list (MYK9-1594)
header-action-show-tool-late-entry	apps/myk9show/src/components/layout/HeaderActions.tsx	header-action-${action.id}	buildShowToolActions ids rows show-tool-<tool id>; late-entry is registered by Entry Forms (MYK9-1594)
header-action-show-tool-people-at-show	apps/myk9show/src/components/layout/HeaderActions.tsx	header-action-${action.id}	buildShowToolActions ids rows show-tool-<tool id>; people-at-show is the Show Desk tool Entry Forms registers (MYK9-1594)
