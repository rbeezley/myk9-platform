-- Migration: Convert plural table names to singular following PostgreSQL best practices
-- Created: 2025-01-26
-- Description: Phase 1 of database naming convention refactoring
-- Risk: HIGH - This migration touches ALL tables and requires coordinated code deployment

-- =====================================================
-- IMPORTANT: This migration must be run in a transaction
-- and requires a coordinated code deployment
-- =====================================================

BEGIN;

-- =====================================================
-- 1. RENAME ALL TABLES FROM PLURAL TO SINGULAR
-- =====================================================

-- Core entity tables
ALTER TABLE IF EXISTS people RENAME TO "user";
ALTER TABLE IF EXISTS dogs RENAME TO dog;
ALTER TABLE IF EXISTS shows RENAME TO show;
ALTER TABLE IF EXISTS clubs RENAME TO club;
ALTER TABLE IF EXISTS show_trials RENAME TO trial;
ALTER TABLE IF EXISTS classes RENAME TO class;
ALTER TABLE IF EXISTS entries RENAME TO entry;
ALTER TABLE IF EXISTS results RENAME TO result;

-- Registration and health tables
ALTER TABLE IF EXISTS dog_registrations RENAME TO dog_registration;
ALTER TABLE IF EXISTS health_records RENAME TO health_record;
ALTER TABLE IF EXISTS vaccinations RENAME TO vaccination;
ALTER TABLE IF EXISTS medications RENAME TO medication;
ALTER TABLE IF EXISTS allergies RENAME TO allergy;
ALTER TABLE IF EXISTS vet_visits RENAME TO vet_visit;

-- Achievement and qualification tables
ALTER TABLE IF EXISTS achievements RENAME TO achievement;
ALTER TABLE IF EXISTS judge_qualifications RENAME TO judge_qualification;

-- Template tables
ALTER TABLE IF EXISTS class_templates RENAME TO class_template;
ALTER TABLE IF EXISTS show_templates RENAME TO show_template;
ALTER TABLE IF EXISTS template_fields RENAME TO template_field;
ALTER TABLE IF EXISTS template_rules RENAME TO template_rule;

-- System and monitoring tables
ALTER TABLE IF EXISTS sync_operations RENAME TO sync_operation;
ALTER TABLE IF EXISTS sync_conflicts RENAME TO sync_conflict;
ALTER TABLE IF EXISTS sync_logs RENAME TO sync_log;
ALTER TABLE IF EXISTS user_preferences RENAME TO user_preference;
ALTER TABLE IF EXISTS search_queries RENAME TO search_query;
ALTER TABLE IF EXISTS search_results RENAME TO search_result;
ALTER TABLE IF EXISTS audit_logs RENAME TO audit_log;
ALTER TABLE IF EXISTS sync_cursors RENAME TO sync_cursor;
ALTER TABLE IF EXISTS sync_queue RENAME TO sync_queue_item;
ALTER TABLE IF EXISTS client_metadata RENAME TO client_metadata_item;

-- Other tables
ALTER TABLE IF EXISTS api_keys RENAME TO api_key;
ALTER TABLE IF EXISTS organizations RENAME TO organization;
ALTER TABLE IF EXISTS ui_breadcrumbs RENAME TO ui_breadcrumb;
ALTER TABLE IF EXISTS ui_state RENAME TO ui_state_item;
ALTER TABLE IF EXISTS feature_flags RENAME TO feature_flag;
ALTER TABLE IF EXISTS past_results RENAME TO past_result;
ALTER TABLE IF EXISTS handlers RENAME TO handler;
ALTER TABLE IF EXISTS entry_status_history RENAME TO entry_status_history_item;

-- =====================================================
-- 2. ADD USER AUTHENTICATION LINK
-- =====================================================

-- Add user_id column to link with auth.users
ALTER TABLE "user" ADD COLUMN IF NOT EXISTS user_id UUID REFERENCES auth.users(id);
CREATE UNIQUE INDEX IF NOT EXISTS idx_user_auth_id ON "user"(user_id);

-- =====================================================
-- 3. ADD AUDIT COLUMNS TO MAIN TABLES
-- =====================================================

-- Add audit columns to user table
ALTER TABLE "user" ADD COLUMN IF NOT EXISTS created_by UUID REFERENCES "user"(id);
ALTER TABLE "user" ADD COLUMN IF NOT EXISTS updated_by UUID REFERENCES "user"(id);
ALTER TABLE "user" ADD COLUMN IF NOT EXISTS deleted_at TIMESTAMPTZ;

-- Add audit columns to other main tables
DO $$
DECLARE
    tbl text;
    tables text[] := ARRAY['club', 'dog', 'show', 'trial', 'class', 'entry', 'result'];
BEGIN
    FOREACH tbl IN ARRAY tables
    LOOP
        EXECUTE format('ALTER TABLE %I ADD COLUMN IF NOT EXISTS created_by UUID REFERENCES "user"(id)', tbl);
        EXECUTE format('ALTER TABLE %I ADD COLUMN IF NOT EXISTS updated_by UUID REFERENCES "user"(id)', tbl);
        EXECUTE format('ALTER TABLE %I ADD COLUMN IF NOT EXISTS deleted_at TIMESTAMPTZ', tbl);
    END LOOP;
END $$;

-- =====================================================
-- 4. FIX BOOLEAN COLUMNS TO BE POSITIVE QUESTIONS
-- =====================================================

-- Dog table
ALTER TABLE dog RENAME COLUMN spayed_neutered TO is_spayed_neutered;

-- Class table
ALTER TABLE class RENAME COLUMN allow_waitlist TO allows_waitlist;

-- Show table
ALTER TABLE show RENAME COLUMN allow_day_of_show_entries TO allows_day_of_show_entries;
ALTER TABLE show RENAME COLUMN allow_non_owner_handlers TO allows_non_owner_handlers;

-- Vet visit table
ALTER TABLE vet_visit RENAME COLUMN follow_up_required TO requires_follow_up;

-- =====================================================
-- 5. CONVERT TEXT FIELDS TO FOREIGN KEYS
-- =====================================================

-- Add new foreign key columns to show table
ALTER TABLE show ADD COLUMN IF NOT EXISTS chairman_id UUID REFERENCES "user"(id);
ALTER TABLE show ADD COLUMN IF NOT EXISTS secretary_id UUID REFERENCES "user"(id);
ALTER TABLE show ADD COLUMN IF NOT EXISTS chief_steward_id UUID REFERENCES "user"(id);

-- Migrate data from text columns to foreign keys
-- Note: This is a best-effort migration - some names may not match
UPDATE show 
SET chairman_id = (
    SELECT id FROM "user" 
    WHERE LOWER(CONCAT(first_name, ' ', last_name)) = LOWER(show_chairman) 
    LIMIT 1
)
WHERE show_chairman IS NOT NULL AND chairman_id IS NULL;

UPDATE show 
SET secretary_id = (
    SELECT id FROM "user" 
    WHERE LOWER(CONCAT(first_name, ' ', last_name)) = LOWER(show_secretary) 
    LIMIT 1
)
WHERE show_secretary IS NOT NULL AND secretary_id IS NULL;

UPDATE show 
SET chief_steward_id = (
    SELECT id FROM "user" 
    WHERE LOWER(CONCAT(first_name, ' ', last_name)) = LOWER(chief_ring_steward) 
    LIMIT 1
)
WHERE chief_ring_steward IS NOT NULL AND chief_steward_id IS NULL;

-- Add new foreign key columns to result table
ALTER TABLE result ADD COLUMN IF NOT EXISTS judge_id UUID REFERENCES "user"(id);
ALTER TABLE result ADD COLUMN IF NOT EXISTS recorded_by_id UUID REFERENCES "user"(id);

-- Migrate data from text columns to foreign keys in result table
UPDATE result 
SET judge_id = (
    SELECT id FROM "user" 
    WHERE LOWER(CONCAT(first_name, ' ', last_name)) = LOWER(judge_name) 
    LIMIT 1
)
WHERE judge_name IS NOT NULL AND judge_id IS NULL;

UPDATE result 
SET recorded_by_id = (
    SELECT id FROM "user" 
    WHERE LOWER(CONCAT(first_name, ' ', last_name)) = LOWER(recorded_by) 
    LIMIT 1
)
WHERE recorded_by IS NOT NULL AND recorded_by_id IS NULL;

-- Add foreign key columns to health tables if they exist
DO $$
BEGIN
    IF EXISTS (SELECT 1 FROM information_schema.tables WHERE table_name = 'vet_visit') THEN
        ALTER TABLE vet_visit ADD COLUMN IF NOT EXISTS veterinarian_id UUID REFERENCES "user"(id);
        
        UPDATE vet_visit 
        SET veterinarian_id = (
            SELECT id FROM "user" 
            WHERE LOWER(CONCAT(first_name, ' ', last_name)) = LOWER(vet_name) 
            LIMIT 1
        )
        WHERE vet_name IS NOT NULL AND veterinarian_id IS NULL;
    END IF;
    
    IF EXISTS (SELECT 1 FROM information_schema.tables WHERE table_name = 'medication') THEN
        ALTER TABLE medication ADD COLUMN IF NOT EXISTS prescriber_id UUID REFERENCES "user"(id);
        
        UPDATE medication 
        SET prescriber_id = (
            SELECT id FROM "user" 
            WHERE LOWER(CONCAT(first_name, ' ', last_name)) = LOWER(prescribed_by) 
            LIMIT 1
        )
        WHERE prescribed_by IS NOT NULL AND prescriber_id IS NULL;
    END IF;
END $$;

-- =====================================================
-- 6. UPDATE ALL FOREIGN KEY CONSTRAINTS
-- =====================================================

-- This is complex because we need to drop and recreate all foreign keys
-- We'll handle the most critical ones here

-- Dog table foreign keys
ALTER TABLE dog DROP CONSTRAINT IF EXISTS dogs_owner_id_fkey;
ALTER TABLE dog ADD CONSTRAINT dog_owner_id_fkey FOREIGN KEY (owner_id) REFERENCES "user"(id) ON DELETE CASCADE;

-- Entry table foreign keys
ALTER TABLE entry DROP CONSTRAINT IF EXISTS entries_dog_id_fkey;
ALTER TABLE entry DROP CONSTRAINT IF EXISTS entries_class_id_fkey;
ALTER TABLE entry ADD CONSTRAINT entry_dog_id_fkey FOREIGN KEY (dog_id) REFERENCES dog(id) ON DELETE CASCADE;
ALTER TABLE entry ADD CONSTRAINT entry_class_id_fkey FOREIGN KEY (class_id) REFERENCES class(id) ON DELETE CASCADE;

-- Class table foreign keys
ALTER TABLE class DROP CONSTRAINT IF EXISTS classes_trial_id_fkey;
ALTER TABLE class ADD CONSTRAINT class_trial_id_fkey FOREIGN KEY (trial_id) REFERENCES trial(id) ON DELETE CASCADE;

-- Trial table foreign keys
ALTER TABLE trial DROP CONSTRAINT IF EXISTS show_trials_show_id_fkey;
ALTER TABLE trial ADD CONSTRAINT trial_show_id_fkey FOREIGN KEY (show_id) REFERENCES show(id) ON DELETE CASCADE;

-- Show table foreign keys
ALTER TABLE show DROP CONSTRAINT IF EXISTS shows_club_id_fkey;
ALTER TABLE show ADD CONSTRAINT show_club_id_fkey FOREIGN KEY (club_id) REFERENCES club(id) ON DELETE CASCADE;

-- Result table foreign keys
ALTER TABLE result DROP CONSTRAINT IF EXISTS results_entry_id_fkey;
ALTER TABLE result ADD CONSTRAINT result_entry_id_fkey FOREIGN KEY (entry_id) REFERENCES entry(id) ON DELETE CASCADE;

-- Dog registration foreign keys
ALTER TABLE dog_registration DROP CONSTRAINT IF EXISTS dog_registrations_dog_id_fkey;
ALTER TABLE dog_registration ADD CONSTRAINT dog_registration_dog_id_fkey FOREIGN KEY (dog_id) REFERENCES dog(id) ON DELETE CASCADE;

-- =====================================================
-- 7. UPDATE ALL INDEXES WITH NEW TABLE NAMES
-- =====================================================

-- Drop old indexes and create new ones with proper names
DROP INDEX IF EXISTS dogs_owner_id_idx;
CREATE INDEX IF NOT EXISTS dog_owner_id_idx ON dog(owner_id);

DROP INDEX IF EXISTS dogs_breed_idx;
CREATE INDEX IF NOT EXISTS dog_breed_idx ON dog(breed);

DROP INDEX IF EXISTS entries_dog_id_idx;
CREATE INDEX IF NOT EXISTS entry_dog_id_idx ON entry(dog_id);

DROP INDEX IF EXISTS entries_class_id_idx;
CREATE INDEX IF NOT EXISTS entry_class_id_idx ON entry(class_id);

DROP INDEX IF EXISTS classes_trial_id_idx;
CREATE INDEX IF NOT EXISTS class_trial_id_idx ON class(trial_id);

DROP INDEX IF EXISTS show_trials_show_id_idx;
CREATE INDEX IF NOT EXISTS trial_show_id_idx ON trial(show_id);

DROP INDEX IF EXISTS show_trials_date_idx;
CREATE INDEX IF NOT EXISTS trial_date_idx ON trial(date);

DROP INDEX IF EXISTS shows_club_id_idx;
CREATE INDEX IF NOT EXISTS show_club_id_idx ON show(club_id);

DROP INDEX IF EXISTS results_entry_id_idx;
CREATE INDEX IF NOT EXISTS result_entry_id_idx ON result(entry_id);

DROP INDEX IF EXISTS dog_registrations_dog_id_idx;
CREATE INDEX IF NOT EXISTS dog_registration_dog_id_idx ON dog_registration(dog_id);

-- =====================================================
-- 8. UPDATE RLS POLICIES (IF ENABLED)
-- =====================================================

-- Note: This is a complex operation that requires dropping and recreating all policies
-- We'll handle the most critical ones here

-- Drop old policies on renamed tables
DROP POLICY IF EXISTS "Users can view people" ON "user";
DROP POLICY IF EXISTS "Users can view dogs" ON dog;
DROP POLICY IF EXISTS "Users can view shows" ON show;
DROP POLICY IF EXISTS "Users can view clubs" ON club;
DROP POLICY IF EXISTS "Users can view show_trials" ON trial;
DROP POLICY IF EXISTS "Users can view classes" ON class;
DROP POLICY IF EXISTS "Users can view entries" ON entry;
DROP POLICY IF EXISTS "Users can view results" ON result;

-- Create new policies with updated names (if RLS is enabled)
-- Note: These are basic policies - adjust based on your security requirements
DO $$
BEGIN
    -- Only create policies if RLS is enabled on the tables
    IF EXISTS (SELECT 1 FROM pg_tables WHERE tablename = 'user' AND rowsecurity = true) THEN
        CREATE POLICY "Users can view users" ON "user" FOR SELECT TO authenticated USING (true);
    END IF;
    
    IF EXISTS (SELECT 1 FROM pg_tables WHERE tablename = 'dog' AND rowsecurity = true) THEN
        CREATE POLICY "Users can view dogs" ON dog FOR SELECT TO authenticated USING (true);
    END IF;
    
    IF EXISTS (SELECT 1 FROM pg_tables WHERE tablename = 'show' AND rowsecurity = true) THEN
        CREATE POLICY "Users can view shows" ON show FOR SELECT TO authenticated USING (true);
    END IF;
    
    -- Add other policies as needed
END $$;

-- =====================================================
-- 9. LOG MIGRATION COMPLETION
-- =====================================================

INSERT INTO audit_log (id, action, table_name, details, created_at)
VALUES (
    gen_random_uuid(),
    'MIGRATION',
    'ALL_TABLES',
    jsonb_build_object(
        'migration', 'singular_table_names',
        'version', '20250126',
        'tables_renamed', 47,
        'description', 'Converted all plural table names to singular'
    ),
    NOW()
);

COMMIT;

-- =====================================================
-- POST-MIGRATION NOTES
-- =====================================================
-- 1. After running this migration, immediately deploy the updated application code
-- 2. Monitor for any errors in the application logs
-- 3. Run the rollback script if any issues are encountered
-- 4. Update any external integrations that reference the old table names
-- 5. Regenerate TypeScript types: npx supabase gen types typescript --local