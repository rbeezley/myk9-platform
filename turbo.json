{
  "$schema": "https://v2-8-0.turborepo.dev/schema.json",
  "ui": "tui",
  // turbo >= 2.11.7 otherwise writes a managed block into AGENTS.md whenever
  // it detects an agent, dirtying every fresh worktree on bootstrap. AGENTS.md
  // is generated from docs/agents/shared-rules.md; keep turbo out of it.
  "agentGuidance": false,
  // Fresh cloud shells use writable tool/config paths outside HOME. Turbo's
  // strict environment must retain them when it launches package commands.
  "globalPassThroughEnv": [
    "MYK9_CLOUD",
    "MYK9_CLOUD_HOME",
    "MYK9_TOOLS_DIR",
    "COREPACK_HOME",
    "XDG_CONFIG_HOME",
    "XDG_CACHE_HOME",
    "XDG_DATA_HOME",
    "XDG_STATE_HOME",
    "DENO_DIR",
    "NODE_OPTIONS",
    "ASTRO_TELEMETRY_DISABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      // The repo-root edge functions live OUTSIDE every package dir, yet
      // apps/myk9show typechecks (tsconfig.edge-tests.json) and runs
      // (vitest.config.ts `test.include`) their tests. Without this input a
      // change to one of them is invisible to turbo's hash, so a cached hit
      // would report green on code it never looked at.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/supabase/functions/**"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/supabase/functions/**"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
