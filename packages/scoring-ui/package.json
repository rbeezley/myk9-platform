{
  "name": "@myk9/scoring-ui",
  "version": "0.0.1",
  "description": "Shared UI hooks and components for dog show scoring",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@myk9/core": "workspace:*",
    "@myk9/ui": "workspace:*"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/sortable": "^8.0.0 || ^9.0.0",
    "@tanstack/react-query": "^5.0.0",
    "lucide-react": ">=0.300.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^9.0.0",
    "@tanstack/react-query": "^5.75.5",
    "@types/react": "^19.1.4",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "tsup": "^8.5.1",
    "typescript": "~5.8.3"
  }
}
