{
  "name": "@myk9/scoring",
  "version": "0.0.1",
  "description": "Scoring logic, stores, hooks, and utilities for dog show scoring",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@myk9/test-utils": "workspace:*",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.1.8",
    "react": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8"
  }
}
