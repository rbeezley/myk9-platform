{
  "name": "myk9-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for the myK9 platform",
  "scripts": {
    "dev:show": "turbo dev --filter=@myk9/show",
    "build": "turbo build",
    "build:show": "turbo build --filter=@myk9/show",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "qa:e2e-map:check": "node scripts/check-e2e-suite-map.js",
    "qa:nightly:prepare": "bash scripts/qa/run-nightly-isolated.sh",
    "qa:discovery:crud": "pnpm --dir apps/myk9show test:e2e:clean src/test/e2e/entities/dogCRUD.spec.ts src/test/e2e/entities/clubCRUD.spec.ts src/test/e2e/entities/peopleCRUD.spec.ts src/test/e2e/entities/classCRUD.spec.ts src/test/e2e/entities/trialCRUD.spec.ts src/test/e2e/entities/showCRUD.spec.ts --project=chromium --workers=1 --timeout=90000 --retries=0",
    "qa:discovery:crud:full": "pnpm --dir apps/myk9show test:e2e:clean src/test/e2e/entities/dogCRUD.spec.ts src/test/e2e/entities/clubCRUD.spec.ts src/test/e2e/entities/peopleCRUD.spec.ts src/test/e2e/entities/classCRUD.spec.ts src/test/e2e/entities/trialCRUD.spec.ts src/test/e2e/entities/showCRUD.spec.ts --project=chromium --workers=1 --timeout=90000 --retries=0",
    "qa:db-drift:enum": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/qa/db-drift/enum-check-drift.ts",
    "qa:db-drift:functions": "SUPABASE_PROJECT_REF=sojmvhhwsjxmfistvzbe node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/qa/db-drift/function-inventory.ts",
    "qa:db-drift:test": "vitest run scripts/qa/db-drift/*.test.ts",
    "test": "turbo test",
    "test:packages": "turbo test --filter=@myk9/core --filter=@myk9/replication --filter=@myk9/ringside --filter=@myk9/scoring --filter=@myk9/scoring-ui --filter=@myk9/supabase --filter=@myk9/ui",
    "test:packages:coverage": "turbo test --filter=@myk9/core --filter=@myk9/replication --filter=@myk9/ringside --filter=@myk9/scoring --filter=@myk9/scoring-ui --filter=@myk9/supabase --filter=@myk9/ui -- --coverage",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.16",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "eslint-plugin-react-hooks": "7.0.1",
      "@supabase/supabase-js": "2.108.0",
      "undici": "^7.16.0",
      "path-to-regexp": "^8.2.0",
      "@isaacs/brace-expansion": "5.0.1",
      "@vercel/python-analysis>minimatch": "10.2.5",
      "@vercel/python-analysis>smol-toml": "1.6.1",
      "@vercel/static-config>ajv": "8.20.0",
      "serialize-javascript": "7.0.5",
      "workbox-build": "7.4.1",
      "ws": "8.20.1",
      "yaml": "2.8.3"
    }
  }
}
